#pragma once

// config.h.example — template for what this panel DISPLAYS. Copy to `config.h`.
//
// This file has NO secrets: WiFi/HA credentials and the timezone live in
// secrets.h (generated by the setup wizard, gitignored). config.h holds only the
// entities, tiles, icons, and hardware pins — so it's safe to share or paste into
// an LLM when adding devices. See the README "Adding devices" section.

// Network name this panel advertises (mDNS: <name>.local) and uses for OTA.
// Running more than one panel? Give each one a UNIQUE name here, or they'll
// collide on "tessera.local" and OTA to either one becomes unreliable.
#define OTA_HOSTNAME "tessera"

// Header temperatures (read-only): indoor from a climate entity's
// current_temperature, outdoor from a weather entity's temperature attribute.
#define ENTITY_INDOOR_TEMP  "climate.your_thermostat"
#define ENTITY_OUTDOOR_TEMP "weather.forecast_home"
#define ENTITY_THERMO_FAN   "fan.your_thermostat_fan"

// Thermostat: 1 = show the Nest thermostat tile, detail view, and indoor header
// temp; 0 = hide all of them (use this if the thermostat isn't in Home Assistant).
#define THERMOSTAT_ENABLED 0

// Display
#define IDLE_DIM_MS   60000
#define BRIGHT_FULL   255
#define BRIGHT_DIM    40

// Screensaver: 1 = after the screen has been idle for SCREENSAVER_IDLE_MS, show a
// subtle LCARS-style animation over the tiles. Any touch returns to the grid.
// It runs after the dim, which still happens at IDLE_DIM_MS.
#define SCREENSAVER_ENABLED 0
#define SCREENSAVER_IDLE_MS 300000

// Backlight GPIO (verify against tested configs if backlight doesn't work)
#define PIN_BACKLIGHT 38

// GT911 touch pins (from NorthernMan54/ESP32-4848S040 — verify if touch doesn't work)
#define PIN_TOUCH_SDA  19
#define PIN_TOUCH_SCL  45
#define PIN_TOUCH_INT  -1
#define PIN_TOUCH_RST  -1

// Material Design Icons glyphs (codepoints from @mdi/font; rendered with the
// generated `mdi_icons` LVGL font). UCNs encode as UTF-8 for lv_label_set_text.
//
// THIS IS THE COMPLETE ICON CATALOG — a tile's `icon` must be one of these
// ICON_* names. Only the glyphs listed here are compiled into the font; using
// any other codepoint shows a blank box. To add a NEW icon, see the README
// "Adding devices" section (you regenerate the font with the new codepoint).
#define ICON_LIGHTBULB     "\U000F0335"  // lightbulb
#define ICON_FAN           "\U000F1797"  // ceiling-fan
#define ICON_BED           "\U000F02E3"  // bed
#define ICON_CEILING_LIGHT "\U000F0769"  // ceiling-light
#define ICON_SOFA          "\U000F04B9"  // sofa
#define ICON_COACH_LAMP    "\U000F1020"  // coach-lamp (outdoor)
#define ICON_FAN_LIGHT     "\U000F1798"  // ceiling-fan-light
#define ICON_HOME_TEMP     "\U000F0F55"  // home-thermometer-outline (indoor)
#define ICON_WEATHER       "\U000F0595"  // weather-partly-cloudy (outdoor)
#define ICON_THERMOSTAT    "\U000F0393"  // thermostat (climate tile)

// Tiles are no longer defined here. The layout comes from Home Assistant:
// /config/www/tessera/layout.json, served as /local/tessera/layout.json.
// See layout.example.json and the README "Adding devices" section.
